# Copy to .env and fill in only what you use:  cp .env.example .env
# .env stays on your computer. Never commit it, paste it into chat or Notion, or send it to teammates.
# Values exported in the shell take precedence over this file.

# ---- LLM keys
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ---- Langfuse tracing (optional; empty keys = tracing off)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# region of the project: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com, https://jp.cloud.langfuse.com, or a self-hosted URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# how much record text is sent: units (default) | full | none (use none for anything but synthetic data)
TRACE_CONTENT=units
# tag shown on every trace: dev, test, variants ...
TRACE_LABEL=dev
# 0 turns tracing off without deleting the keys
TRACING=auto

# ---- per-run settings (optional)
# LLM_DEADLINE=120
# REASONING_EFFORT=low
