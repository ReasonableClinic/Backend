# Agent 2 settings. Copy this file to .env in the same folder and fill in your own values:
#   cp .env.example .env
# .env stays on your computer only. Never commit it, paste it into chat or Notion, or send it to teammates.
# Values exported in the shell take precedence over this file.

# ---- LLM keys (fill in only the provider you use)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ---- Langfuse tracing (optional; leave the keys empty to run without tracing)
# Keys are under Project settings > API keys at https://cloud.langfuse.com (or your own server).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com   US cloud: https://us.cloud.langfuse.com   self-hosted: your server URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# How much record text is sent: units (default) | full | none. Use none for anything but synthetic data.
AGENT2_TRACE_CONTENT=units
# Label for runs, shown as a tag in Langfuse (for example dev, test, variants)
AGENT2_TRACE_LABEL=dev
# Turn tracing off without deleting the keys: 0
AGENT2_TRACING=auto

# ---- Speed settings (optional; the defaults are in agent2/backends.py)
# LLM_DEADLINE=120
# REASONING_EFFORT=low
