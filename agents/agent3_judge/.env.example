# Agent 3 settings. Copy this file to .env in the same folder and fill in your own key:
#   cp .env.example .env
# .env stays on your computer only. Never commit it, paste it into chat or Notion, or send it to teammates.
# Values exported in the shell take precedence over this file.

# Claude (Anthropic) API key, used by scripts/run_dev.sh and `python3 -m agent3.run --llm anthropic`
ANTHROPIC_API_KEY=

# Only for --llm openai (OpenAI-compatible endpoint such as vLLM); leave empty otherwise
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
